{
  "name": "center-owner-app",
  "version": "1.0.0",
  "description": "Production-ready MERN Rent Receipt Generator SPA matching typewriter format with A4 duplicate printing",
  "scripts": {
    "server": "npm run start --prefix server",
    "server:dev": "npm run dev --prefix server",
    "seed": "npm run seed --prefix server",
    "client": "npm run dev --prefix client",
    "client:build": "npm run build --prefix client",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server:dev\" \"npm run client\"",
    "start": "npm run start --prefix server",
    "build": "npm run build --prefix client"
  },
  "keywords": ["rent-receipt", "mern", "receipt-generator", "spa", "vite", "react"],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
