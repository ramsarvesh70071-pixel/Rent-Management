# ========================================================
# BACKEND ENVIRONMENT VARIABLES (Render / Railway / Vercel Serverless)
# ========================================================
PORT=5000
NODE_ENV=production

# MongoDB Atlas Cloud Connection String (Localhost cloud par kaam nahi karega)
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/rent_receipt_db?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/rent_receipt_db?retryWrites=true&w=majority

# ========================================================
# FRONTEND ENVIRONMENT VARIABLES (Vercel Project Settings)
# ========================================================
# Agar backend alag hosted hai (jaise Render/Railway par), toh backend ka URL daalein:
VITE_API_URL=https://your-backend-app.onrender.com
